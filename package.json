{
  "name": "hokf-static-search",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned static search tooling for the HOKF Hugo site.",
  "scripts": {
    "pagefind": "pagefind --site site/public",
    "format": "pnpm dlx oxfmt@0.79.0 --write '**/*.{md,mdx,markdown}' --no-error-on-unmatched-pattern",
    "format:check": "pnpm dlx oxfmt@0.79.0 --check '**/*.{md,mdx,markdown}' --no-error-on-unmatched-pattern",
    "lint": "markdownlint-cli2 '**/*.{md,mdx,markdown}'",
    "lint:fix": "markdownlint-cli2 --fix '**/*.{md,mdx,markdown}'"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.1",
    "oxlint": "1.93.0",
    "pagefind": "1.6.0"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4",
      "onFail": "download"
    }
  }
}
