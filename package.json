{
  "name": "hokf-static-search",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned static search tooling for the HOKF Hugo site.",
  "scripts": {
    "pagefind": "pagefind --site site/public"
  },
  "devDependencies": {
    "pagefind": "1.5.2"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4",
      "onFail": "download"
    }
  }
}
